{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RandomNum-You",
  "version": "2.0.0",
  "identifier": "com.flygues.randomnum-you",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RandomNum You",
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/appIcon.ico", "icons/appIcon.svg"],
    "category": "Utility",
    "shortDescription": "随机数抽取器",
    "longDescription": "使用 Tauri 开发的 Material You 风格的随机数抽取器。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "window": {
      "all": true
    }
  }
}
